{
  "name": "lumora-newtab",
  "version": "1.0.0",
  "private": true,
  "description": "Atmospheric glassmorphic New Tab workspace with vertical tabs, live media controls, Mochi notifications, and optional Gemini AI.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-assets.mjs && tsc -b && vite build && node scripts/copy-manifest.mjs && node scripts/validate-extension.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run typecheck && node scripts/validate-source.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/michroma": "^5.2.5",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.0.7"
  }
}
